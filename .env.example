# Copy to .env and fill in. Never commit .env.
# 1. Message @BotFather on Telegram -> /newbot -> copy the token here.
TELEGRAM_BOT_TOKEN=

# 2. Message your new bot once ("hi"), then run:  python3 cli.py chatid
TELEGRAM_CHAT_ID=

# Minutes between scans in `watch` mode.
POLL_MINUTES=15

# Set to 1 to print alerts to the terminal instead of sending to Telegram.
DRY_RUN=0
